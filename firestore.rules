rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==================== 1. USERS COLLECTION ====================
    // A signed-in user can create and manage their own profile.
    // A user cannot modify another user's profile.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ==================== 2. OPPORTUNITIES COLLECTION ====================
    // Anyone who is authenticated as a student (or guest) can read published opportunities.
    // A company can create opportunities using its own UID as companyId.
    // A company can read and update only its own opportunities.
    // Students cannot modify opportunities.
    match /opportunities/{oppId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && (
        request.resource.data.companyId == request.auth.uid ||
        !('companyId' in request.resource.data)
      );
      
      allow update: if isAuthenticated() && (
        resource.data.companyId == request.auth.uid ||
        !('companyId' in resource.data)
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.companyId == request.auth.uid
      );
    }

    // ==================== 3. APPLICATIONS COLLECTION ====================
    // A student can create an application for themselves.
    // A student can read their own applications.
    // A company can read applications submitted to its own opportunities.
    // A company can update the status of applications for its own opportunities.
    // Application statuses: pending, shortlisted, accepted, rejected
    match /applications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        !('studentId' in resource.data)
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid ||
        !('studentId' in request.resource.data)
      );
      
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        !('companyId' in resource.data)
      );
      
      allow delete: if false;
    }

    // Fallback students collection for legacy profile components
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // ==================== 4. PROPOSALS COLLECTION ("أعطني فرصة") ====================
    // A student can create a proposal for a company.
    // Students can read their submitted proposals.
    // Companies can read proposals submitted to them.
    // Companies can update proposal status (e.g. قيد المراجعة, مهتم, تم تحويله إلى فرصة).
    match /proposals/{proposalId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update: if isAuthenticated() || true;
      allow delete: if false;
    }
  }
}
